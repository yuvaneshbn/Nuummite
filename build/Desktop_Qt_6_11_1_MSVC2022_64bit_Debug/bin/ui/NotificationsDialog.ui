<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
  <class>NotificationsDialog</class>
  <widget class="QDialog" name="NotificationsDialog">
    <property name="windowTitle"><string>Notifications</string></property>
    <layout class="QVBoxLayout" name="verticalLayout">
      <item>
        <widget class="QListWidget" name="notificationsList"/>
      </item>
      <item>
        <widget class="QPushButton" name="clearButton">
          <property name="text"><string>Clear All</string></property>
        </widget>
      </item>
    </layout>
  </widget>
  <resources/>
  <connections>
    <connection>
      <sender>clearButton</sender>
      <signal>clicked()</signal>
      <receiver>NotificationsDialog</receiver>
      <slot>clearNotifications()</slot>
    </connection>
  </connections>
</ui>
